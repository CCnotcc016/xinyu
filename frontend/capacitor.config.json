{
  "appId": "com.xinyu.app",
  "appName": "心语",
  "webDir": "dist",
  "server": {
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#06101a"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": false,
      "backgroundColor": "#06101a",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": false
    }
  }
}
