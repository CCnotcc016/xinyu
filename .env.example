# 心语 · 环境变量示例
# 用法：cp .env.example .env 然后填入真实值
#   - Docker 部署：docker compose up -d（compose 会自动读取 .env）
#   - 本机开发：bash scripts/run-dev.sh（脚本会自动读取 .env）
# .env 已被 .gitignore 忽略，真实密钥只放在这里，不要写进 application.yml

# MySQL root 密码（生产环境务必修改）
MYSQL_PASSWORD=root

# AI 大模型配置（DeepSeek / 通义 / OpenAI 兼容接口）
# 留空则自动降级为离线 Mock 陪伴回复，功能仍可演示
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# JWT 签名密钥（生产环境必填，生成方式：openssl rand -hex 32）
# 生产环境不设置会导致后端启动失败，这是故意的：避免用公开默认值签发 token 被伪造
JWT_SECRET=

# ---------- 仅本机开发需要（Docker 部署时删掉这一段）----------
# 提示：URL 含 & 符号，取消注释时必须用引号包起来，否则 source 时会被 shell 当成后台执行
# SPRING_PROFILES_ACTIVE=dev
# SPRING_DATASOURCE_URL="jdbc:mysql://127.0.0.1:3306/xinyu?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true"
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=root
# SPRING_DATA_REDIS_PORT=6399
