# 心语 · 环境变量示例
# 用法：cp .env.example .env 然后填入真实值
#   - Docker 部署：docker compose up -d（compose 会自动读取 .env）
#   - 本机开发：bash scripts/run-dev.sh（脚本会自动读取 .env）
# .env 已被 .gitignore 忽略，真实密钥只放在这里，不要写进 application.yml

# ---------- 数据库 / 缓存（Docker 部署必填，全部没有默认值）----------
# MySQL root 密码：只给容器初始化用
MYSQL_ROOT_PASSWORD=
# 后端实际连库用的应用账号（不再是 root，注入 / 配置泄漏时少一层权限）
MYSQL_USER=xinyu
MYSQL_APP_PASSWORD=
MYSQL_DB=xinyu
# Redis 密码：不设密码的 Redis 等于把会话与限流数据公开
REDIS_PASSWORD=

# ---------- 首个管理员（库里没有可用管理员时由后端引导创建）----------
# 密码必须满足强度策略：8-32 位、含字母和数字、不是弱口令、不能包含用户名
# 创建后账号带 must_change_password=1，首次登录必须先改密
ADMIN_INIT_USERNAME=
ADMIN_INIT_PASSWORD=

# ---------- JWT ----------
# 生产必填，生成方式：openssl rand -hex 32
# 不设置会导致后端启动失败，这是故意的：避免用公开默认值签发 token 被伪造
JWT_SECRET=
# 有效期（毫秒），默认 24 小时。改小更安全，改大更方便
JWT_EXPIRATION=86400000

# ---------- AI 大模型 ----------
# 留空则自动降级为离线 Mock 陪伴回复，功能仍可演示
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# ---------- 端口 / HTTPS ----------
HTTP_PORT=80
HTTPS_PORT=443
# 启用 HTTPS 时指向证书目录（含 fullchain.pem / privkey.pem）：
#   docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d --build
TLS_DIR=./certs

# ---------- 仅本机开发需要（Docker 部署时删掉这一段）----------
# 提示：URL 含 & 符号，取消注释时必须用引号包起来，否则 source 时会被 shell 当成后台执行
# SPRING_PROFILES_ACTIVE=dev
# SPRING_DATASOURCE_URL="jdbc:mysql://127.0.0.1:3306/xinyu?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true"
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=
# SPRING_DATA_REDIS_PORT=6399
