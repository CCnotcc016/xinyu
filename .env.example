# ==================== 环境变量示例 ====================
# 用法：cp .env.example .env 然后填入你自己的真实值
#   - Docker 部署：docker compose up -d（compose 会自动读取 .env）
#   - 本机开发：bash scripts/run-dev.sh（脚本会自动读取 .env）
# 真实密钥只放在 .env 里，不要写进 application.yml，也不要把 .env 提交到仓库。

# ---------- MySQL ----------
# 生产环境务必改成强密码；本机开发保持 root 也可以
MYSQL_PASSWORD=root
# MYSQL_HOST=mysql
# MYSQL_DB=xinyu
# MYSQL_USER=root

# ---------- AI 大模型（DeepSeek / 通义 / OpenAI 兼容接口）----------
# 留空则自动降级为离线 Mock 陪伴回复，功能仍可完整演示
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# ---------- JWT 签名密钥 ----------
# 生成方式：openssl rand -hex 32
# 生产环境不设置会导致后端启动失败，这是故意的：避免用公开默认值签发 token 被伪造
JWT_SECRET=

# ---------- Redis（可选，仅用于接口限流）----------
# 未启动 Redis 时限流会自动降级放行
# SPRING_DATA_REDIS_HOST=127.0.0.1
# SPRING_DATA_REDIS_PORT=6379
# REDIS_PASSWORD=

# ==================== 以下仅本机开发需要（Docker 部署请忽略）====================
# 提示：JDBC URL 里含 & 符号，取消注释时必须用引号包起来，否则 source 时会被 shell 当成后台执行
# SPRING_PROFILES_ACTIVE=dev
# SPRING_DATASOURCE_URL="jdbc:mysql://127.0.0.1:3306/xinyu?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true"
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=root
